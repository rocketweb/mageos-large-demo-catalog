*

# Repository metadata and local environment definition
!/.gitignore
!/.magebox.yaml
!/docker-compose.mageos.yaml
!/README.md

# Composer is the source of truth for Mage-OS, Hyva, and Koti packages
!/composer.json
!/composer.lock

# Project-owned Magento configuration and future custom code/themes
!/app
!/app/*/
!/app/code/**
!/app/design/**
!/app/etc/config.php
!/app/etc/hyva-themes.json

# Reproducible lab tooling and the exact Workbench source archive
!/dev/
!/dev/tools/
!/dev/tools/wands_catalog/
!/dev/tools/wands_catalog/**
!/packages/
!/packages/WORKBENCH_SOURCE.md
!/packages/module-opensearch-relevance-workbench/
!/packages/module-opensearch-relevance-workbench/**

# Python runtime byproducts never belong in source control
**/__pycache__/
*.py[cod]

# Catalog media is distributed separately; tool screenshots/diagrams stay eligible.
# SKU-named product images remain excluded even if copied beside tooling source.
/pub/media/
/var/
WANDS-[0-9]*.[jJ][pP][gG]
WANDS-[0-9]*.[jJ][pP][eE][gG]
WANDS-[0-9]*.[pP][nN][gG]
WANDS-[0-9]*.[wW][eE][bB][pP]
WANDS-[0-9]*.[gG][iI][fF]
WANDS-[0-9]*.[aA][vV][iI][fF]
WANDS-[0-9]*.[tT][iI][fF]
WANDS-[0-9]*.[tT][iI][fF][fF]
WANDS-BUNDLE-[0-9]*.[jJ][pP][gG]
WANDS-BUNDLE-[0-9]*.[jJ][pP][eE][gG]
WANDS-BUNDLE-[0-9]*.[pP][nN][gG]
WANDS-BUNDLE-[0-9]*.[wW][eE][bB][pP]
WANDS-BUNDLE-[0-9]*.[gG][iI][fF]
WANDS-BUNDLE-[0-9]*.[aA][vV][iI][fF]
WANDS-BUNDLE-[0-9]*.[tT][iI][fF]
WANDS-BUNDLE-[0-9]*.[tT][iI][fF][fF]

# Never commit credentials, machine-local overrides, or runtime state
/auth.json
/app/etc/env.php
/.env
/.env.*
/.magebox.local.yaml
/.DS_Store
**/.DS_Store
