<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="MageOS_OpenSearchRelevanceWorkbench::workbench"
                          title="OpenSearch Relevance Workbench" sortOrder="90">
                    <resource id="MageOS_OpenSearchRelevanceWorkbench::view"
                              title="View Status and Results" sortOrder="10"/>
                    <resource id="MageOS_OpenSearchRelevanceWorkbench::preview_queries"
                              title="Preview Query Data" sortOrder="20"/>
                    <resource id="MageOS_OpenSearchRelevanceWorkbench::approve_snapshots"
                              title="Approve Query Snapshots" sortOrder="30"/>
                    <resource id="MageOS_OpenSearchRelevanceWorkbench::curate_ratings"
                              title="Curate Human Ratings" sortOrder="40"/>
                    <resource id="MageOS_OpenSearchRelevanceWorkbench::manage_configurations"
                              title="Manage Search Configurations" sortOrder="50"/>
                    <resource id="MageOS_OpenSearchRelevanceWorkbench::run_experiments"
                              title="Run Offline Experiments" sortOrder="60"/>
                    <resource id="MageOS_OpenSearchRelevanceWorkbench::export_proposals"
                              title="Export Evidence Packages" sortOrder="70"/>
                    <resource id="MageOS_OpenSearchRelevanceWorkbench::apply_live_configuration"
                              title="Activate and Roll Back Live Configuration" sortOrder="75"/>
                    <resource id="MageOS_OpenSearchRelevanceWorkbench::authorize_paid_judgments"
                              title="Authorize Paid Judgments" sortOrder="80"/>
                    <resource id="MageOS_OpenSearchRelevanceWorkbench::manage_settings"
                              title="Manage Workbench Settings" sortOrder="90"/>
                    <resource id="MageOS_OpenSearchRelevanceWorkbench::cleanup_remote_resources"
                              title="Preview Owned Remote Resources" sortOrder="100"/>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
