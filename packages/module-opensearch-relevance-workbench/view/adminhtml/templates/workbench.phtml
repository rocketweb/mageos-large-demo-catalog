$recentExperiments = $block->getRecentExperiments();
$eligibleExperimentInputs = $block->getEligibleExperimentInputs();
$ratingQueueCandidates = [];

foreach ($recentCandidates as $candidate) {
    $candidateSnapshots = $block->getEligibleSnapshots((int)$candidate['store_id']);

    if ($candidateSnapshots !== []) {
        $ratingQueueCandidates[] = ['candidate' => $candidate, 'snapshots' => $candidateSnapshots];
    }
}

$workflowProgress = $block->getWorkflowProgress($preflight, $preview, $liveStates, $activationCandidates);
$recommendedStep = $workflowProgress['recommended_step'];
$workflowStates = $workflowProgress['states'];
$hasActiveCandidate = count(array_filter(
    $liveStates,
    static fn (array $state): bool => ($state['transformation']['type'] ?? 'STOCK') !== 'STOCK'
)) > 0;
